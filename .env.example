# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Find this in: Neon console → Project → Connection Details (pooled URL is fine)
# Server-only: NEVER expose to the client bundle
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# El rol con el que consulta la aplicación. NO es opcional.
#
# Son dos roles a propósito. `DATABASE_URL` entra con el dueño de las tablas
# —corre migraciones, el limitador de tráfico y las sondas de salud— y RLS no
# le aplica. `DATABASE_URL_APP` entra con `claimmix_app`, sin BYPASSRLS, y es
# por donde pasan TODAS las consultas del producto a través de src/data/scope.ts.
#
# Si falta, la capa de datos rompe a propósito en vez de caer al rol viejo: sus
# consultas ya no llevan `WHERE tenant_id`, así que con el rol dueño devolverían
# los datos de todos los inquilinos.
#
# Se crea y se rota con `pnpm rol-app --rotar`.
DATABASE_URL_APP=postgresql://claimmix_app:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# Una base por cliente. Apagada (0) por omisión: hay una sola base y todo anda como siempre.
# Con 1, cada inquilino vive en su propia base, `t_<32 hex de su id>`, en el mismo proyecto
# y compute que la de DATABASE_URL_APP (la de control), y la capa de datos elige sola cuál
# usar. Es de ida: con clientes vivos no se vuelve a apagar, porque la base de control no
# tiene sus datos de negocio. Sólo la prende prd, y recién en su segunda fase; dev, QA y
# staging quedan en 0.
BASE_POR_CLIENTE=0
# Topes del plan para el alta automática con una base por cliente. Pasado cualquiera, el alta
# queda cerrada («Alta cerrada») y no crea nada. 0, o sin poner, es sin tope; máximo 500 cada uno.
# ALTA_TOPE_BASES: cuántas bases de cliente (t_<hex>) puede haber. ALTA_TOPE_MB: cuántos MB
# pesa el proyecto entero (todas las bases a las que el rol puede conectarse, la de control incluida).
# ALTA_TOPE_BASES=0
# ALTA_TOPE_MB=0

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=<random-32-byte-hex>
# Google OAuth client for LOGIN (separate concern from GMAIL_* intake vars below).
# Register redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Default tenant for self-registered / first-time Google users
# (falls back to DEFAULT_TENANT_ID, then GMAIL_TENANT_ID)
GOOGLE_DEFAULT_TENANT_ID=<your-tenant-uuid>
# Segundo lugar de esa misma cadena de fallback, si no hay GOOGLE_DEFAULT_TENANT_ID.
# DEFAULT_TENANT_ID=

# ─── Cloudflare R2 (attachments) ──────────────────────────────────────────────
# Find these in: Cloudflare dashboard → R2 → Manage R2 API Tokens
# Server-only: NEVER expose to the client bundle
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=claim-attachments

# ─── Gemini (default AI provider) ────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# This is the PRIMARY provider — do NOT replace with OpenAI for the main workflow.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash
# Proveedor de IA por omisión, si el inquilino no eligió uno (default "gemini").
# AI_PROVIDER=

# Rate-limit controls — tune to stay within your quota tier
# Minimum ms between Gemini requests (default 1200 = ~50 RPM)
GEMINI_MIN_REQUEST_INTERVAL_MS=1200
# Max retries on recoverable errors (quota / rate-limit / network)
GEMINI_MAX_RETRIES=2
# Base ms for exponential backoff (actual delay = base * 2^attempt)
GEMINI_RETRY_BASE_MS=1000
# Max parallel simulation workers (default 1 = serial, safe for free tier)
GEMINI_WORKER_CONCURRENCY=1
# Extra delay (ms) between consecutive simulation batches (default 0)
GEMINI_WORKER_DELAY_MS=0

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com → API Keys
# Optional — only needed if you switch provider to OpenAI in the admin panel.
OPENAI_API_KEY=

# Set to "true" to skip all AI calls and use the deterministic mock extractor.
# The mock produces realistic Argentine claim data without any API key.
MOCK_AI=true              # Set to true to bypass AI calls
# Mismo efecto que MOCK_AI=true; lo lee además /admin/health para mostrar el modo.
# AI_MOCK=
# Poné "off" en cualquiera de las dos para depurar sin ese paso del agente.
# AGENT_DELIBERATION=
# AGENT_COMPOSE_REPLIES=

# ─── Vertex AI Gemini fine-tuning (advanced — optional) ───────────────────────
# Only required to use supervised fine-tuning via Vertex AI.
# Gemini works without these — examples are used as few-shot context by default.
#
# 1. Enable Vertex AI API: gcloud services enable aiplatform.googleapis.com
# 2. Create a GCS bucket for training datasets
# 3. Set up a service account with roles: Vertex AI User + Storage Object Creator
# 4. Download the service-account JSON key and point GOOGLE_APPLICATION_CREDENTIALS to it
#
# Set VERTEX_AI_TUNING_ENABLED=true to unlock the Vertex AI panel in the admin console.
VERTEX_AI_TUNING_ENABLED=false
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_GEMINI_BASE_MODEL=gemini-2.0-flash-001
VERTEX_AI_BUCKET_NAME=<your-gcs-bucket-name>
# Minimum approved examples required before a tuning job can be created (default 10)
VERTEX_AI_MIN_EXAMPLES=10
# Por dónde sale la extracción, y con qué modelo. Las dos las lee el camino
# caliente del agente y NINGUNA estaba acá: al levantar un entorno nuevo la
# extracción queda muda y el motivo no aparece hasta que llega el primer
# mensaje. `GEMINI_TRANSPORT` la leen cuatro archivos; el modelo, uno.
#
# `vertex` es lo que corre en producción: AI Studio es prepago y en Argentina
# no se puede pagar. Con `ai-studio` hace falta GEMINI_API_KEY.
GEMINI_TRANSPORT=vertex
# El modelo afinado, con su ruta entera de Vertex. Sin esto se usa el base, que
# no es el que se midió.
VERTEX_EXTRACTION_MODEL=<projects/tu-proyecto/locations/us-central1/endpoints/tu-endpoint>
# Path to the service-account JSON key file (for local dev / CI)
# In production on GCP, leave unset — Application Default Credentials are used automatically.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Workload Identity Federation (lo que corre en Vercel); las cuatro juntas o ninguna.
# GCP_PROJECT_NUMBER=<numero-del-proyecto-gcp>
# GCP_WORKLOAD_IDENTITY_POOL_ID=<id-del-pool>
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=<id-del-proveedor-del-pool>
# GCP_SERVICE_ACCOUNT_EMAIL=<cuenta-de-servicio>@<tu-proyecto>.iam.gserviceaccount.com
# Alternativa a las GCP_* de arriba: la clave de la cuenta de servicio entera, en una sola línea.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
# Get from: https://sentry.io → New Project → Next.js → DSN
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Upstash Redis (rate limiting — optional but recommended for production) ───
# Falls back to in-memory LRU if not set (not durable across serverless cold starts)
# Get from: https://upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Con qué se cuenta el tope de tráfico. DEJALA VACÍA salvo que sepas por qué.
#
# Estaba en `memory`, y esta variable GANA sobre la detección automática. O sea
# que sembrar las variables de Vercel desde esta plantilla —que es lo normal—
# dejaba el producto entero contando en memoria: en serverless cada instancia
# arranca con su mapa vacío, así que el tope del login, del ingreso y del
# re-análisis dejaba de existir. Y el aviso que eso produce va a stdout, donde
# en un deploy verde no lo lee nadie.
#
# Vacía, se elige sola: `upstash` si están las dos variables de arriba, si no
# `postgres` cuando hay DATABASE_URL, y `memory` sólo en una máquina de
# desarrollo sin base. Ponela a mano únicamente para forzar algo distinto.
RATE_LIMIT_PROVIDER=

# ─── AI budget controls ────────────────────────────────────────────────────────
# Per-user token cap per day (100k ≈ 33 extractions at ~3k tokens each)
AI_USER_DAILY_TOKEN_CAP=100000
# Per-tenant token cap per day
AI_TENANT_DAILY_TOKEN_CAP=5000000
# Tope diario de tokens de lo que entra sin usuario (mail, WhatsApp, formulario):
# lo que gasta quien no está logueado no puede dejar sin cupo al equipo que sí lo
# está. Sin la variable, el 60 % de AI_TENANT_DAILY_TOKEN_CAP. Con 0 corta de entrada.
# Si se define en Vercel, definirla igual como variable del repo de GitHub: el
# ensayo del deploy corre en el runner y la lee de ahí.
# AI_ANONIMO_DAILY_TOKEN_CAP=
# Tope mensual en USD por inquilino antes de frenar la extracción (default 200).
# MONTHLY_BUDGET_USD=
# El inquilino de la demo pública en /demo, con presupuesto propio y separado.
# DEMO_TENANT_ID=
# Tope diario de tokens de la demo (default 300000), sólo aplica a DEMO_TENANT_ID.
# AI_DEMO_DAILY_TOKEN_CAP=
# Tope mensual en USD de la demo (default 10), sólo aplica a DEMO_TENANT_ID.
# DEMO_MONTHLY_BUDGET_USD=

# ─── Confidence threshold ──────────────────────────────────────────────────────
# Cases with confidence_min below this value are routed to "escalado"
CONFIDENCE_THRESHOLD=0.70

# Días sin respuesta antes de cerrar un caso por abandono (default 14, tope 90).
# CONVERSATION_ABANDON_AFTER_DAYS=
# Milisegundos en "procesando"/"recibido" antes de escalar por trabado (default 20 min).
# SIMULATE_STUCK_REAP_AFTER_MS=

# ─── App ───────────────────────────────────────────────────────────────────────
# Base URL of the deployed app (used for CORS checks, absolute links, and internal
# worker dispatch). Must include the protocol (e.g. https://claimmix.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Si está puesta, dispatch-url.ts la usa antes que NEXT_PUBLIC_SITE_URL para el worker interno.
# NEXT_PUBLIC_APP_URL=

# Vercel automatically injects VERCEL_URL at runtime (hostname only, no https://).
# Do NOT set this manually in .env.local — Vercel sets it for you on deployment.
# VERCEL_URL is the LAST resort, not the first: dispatch-url.ts and
# src/lib/auth/index.ts both read NEXT_PUBLIC_SITE_URL first and fall back to
# VERCEL_URL only when it is empty. That fallback is the per-deployment hash
# host, so leaving NEXT_PUBLIC_SITE_URL empty on a Vercel project makes Better
# Auth answer 403 INVALID_ORIGIN to requests coming from the public alias, and
# points internal dispatch at a URL that sits behind Deployment Protection.
# VERCEL_URL=<auto-set-by-vercel>

# Structured log level: debug | info | warn | error
LOG_LEVEL=info

# ─── Email intake + outbound (Gmail API) ──────────────────────────────────────
# Get via OAuth2 consent flow — see docs/gmail-oauth-setup.md
# Required Gmail API scope: https://www.googleapis.com/auth/gmail.modify
GMAIL_CLIENT_ID=<your-google-oauth-client-id>
GMAIL_CLIENT_SECRET=<your-google-oauth-client-secret>
GMAIL_REFRESH_TOKEN=<your-oauth-refresh-token>
GMAIL_USER_EMAIL=claims@gmail.com
GMAIL_FROM_ADDRESS=claims@gmail.com
# Tenant ID that inbound Gmail messages are routed to (MVP single-inbox mode)
GMAIL_TENANT_ID=<your-tenant-uuid>

# Clave con la que se cifra el refresh token de Gmail en la base (obligatoria, 32+ caracteres).
# GMAIL_TOKEN_ENCRYPTION_KEY=

# ─── Remitente del sistema (mails de activación y de recuperación) ─────────────
# Casilla Gmail PROPIA de la plataforma, no la de ninguna aseguradora, y que NO
# se conecta en Configuración: así el poller de entrada nunca la lee. Sin estas
# dos variables sólo los espacios que no son de alta automática reciben mail de
# recuperación (por su propia casilla), y el correo no se marca como verificado.
# El refresh token tiene que salir del cliente GMAIL_CLIENT_ID de arriba (permiso
# gmail.send y nada más). Sacarlo con scripts/token-remitente.mts, ver su cabecera.
# ALTA_REMITENTE_CORREO=sistema@example.com
# ALTA_REMITENTE_REFRESH_TOKEN=<refresh-token-de-token-remitente>
# Topes por día de ese remitente: en total y por dirección de destino (1-10000 y 1-100).
# El total se cuenta POR TIPO de mail (alta, recuperación, invitación, aviso al operador):
# el tráfico anónimo de /registro no deja sin recuperación a quienes ya tienen cuenta.
# ALTA_TOPE_CORREOS_DIA=50
# ALTA_TOPE_POR_DESTINATARIO_DIA=3
# Pedidos de «Crear cuenta con mi correo» por día y por red (/56 en IPv6), con el desafío ya pasado (1-1000).
# ALTA_TOPE_CORREO_POR_IP_DIA=10
# Invitaciones por día y por espacio desde /admin/users (1-1000); cada intento cuenta, haya o no cuenta del otro lado. En una prueba, el menor entre este valor y 5.
# ALTA_TOPE_INVITACIONES_DIA=20

# ─── Número de WhatsApp por código (alta automática) ───────────────────────────
# Prende «Conectá tu WhatsApp» en Configuración: la persona pide el código por SMS o
# llamada, lo escribe y Meta suma su número a la WABA de la plataforma. Apagado por
# omisión: sin el 1, o sin la migración 0049 en la base, nada llama a Graph. Aplicar la
# 0049 a mano en las tres bases ANTES de prenderlo. Ver docs/whatsapp-setup.md, parte F.
# ALTA_NUMERO_AUTOMATICO=1
# Números en total de la WABA, el de la plataforma y cualquier estado incluidos (1-1000). Meta deja 2 mientras la empresa no está verificada: hoy entra uno.
# ALTA_NUMEROS_MAXIMOS_WABA=2
# Números nuevos por día, de todos los espacios juntos (0-50; 0 cierra).
# ALTA_TOPE_NUMEROS_DIA=2
# Pedidos de código por día y por espacio (0-20).
# ALTA_TOPE_CODIGOS_INQUILINO_DIA=3
# Pedidos de código por día y por red (/56 en IPv6; los que no traen IP comparten uno) (0-50).
# ALTA_TOPE_CODIGOS_IP_DIA=5
# Pedidos de código por día de todos los espacios juntos (0-500; 0 cierra).
# ALTA_TOPE_CODIGOS_DIA=10
# Intentos de entregar un código por hora y por espacio (0-20).
# ALTA_TOPE_VERIFICACIONES_HORA=5

# ─── Lo que es del otro ambiente (sólo prd) ────────────────────────────────────
# prd comparte con dev la app de Meta y el cliente de Google, y los enlaces viejos de dev
# siguen impresos o embebidos. Cada lista va separada por comas, sin importar blancos ni
# mayúsculas. Vacías (dev, QA, local), nada de esto hace nada.
# Enlaces de /denuncia/<slug> de dev: la página y la ruta redirigen (308) a URL_DEL_OTRO_AMBIENTE
# y /api/admin/formulario-web no deja crearlos.
# SLUGS_DE_DEV=mi-aseguradora,otra-aseguradora
# phone_number_id de Meta o E.164 de los números de dev: el panel del operador no los conecta.
# NUMEROS_DE_DEV=123456789012345,+5491100000000
# Casillas Gmail de dev: el callback de Configuración no las guarda.
# CASILLAS_DE_DEV=claims@example.com
# Dónde está dev, sin la barra final. Si está puesta, /login y el error de /invitacion dicen dónde entrar.
# URL_DEL_OTRO_AMBIENTE=https://claimmix-dev.example.com

# ─── Desafío anti-bots de /registro (Cloudflare Turnstile) ─────────────────────
# Sólo frena «Crear cuenta con mi correo»; Google no lo usa. Se necesitan LAS DOS
# claves: con una sola (o ninguna) no hay desafío, no se llama a Cloudflare y la
# CSP no abre challenges.cloudflare.com. Con las dos, un desafío no resuelto
# termina como cualquier otro final de /registro, sin mail. La del sitio es pública.
# Con ALTA_AUTOMATICA=1 conviene tener las dos puestas: sin desafío, lo único que
# frena a un script en /registro son los topes por red y por tipo de mail.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Secret used to authenticate Vercel cron invocations.
# Vercel injects this automatically; set it in Vercel dashboard + local .env.local.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel's Preview scope gets its own value, never production's: set a different
# CRON_SECRET there and store the same value as the repo secret PREVIEW_CRON_SECRET
# (only load-tests.yml reads it).
CRON_SECRET=<random-32-byte-hex>

# ─── Gmail Push Notifications (Pub/Sub) ─────────────────────────────────────
# Setup: see https://cloud.google.com/pubsub/docs/push
# Full topic resource: projects/PROJECT_ID/topics/TOPIC_NAME
PUBSUB_TOPIC=projects/<your-project-id>/topics/gmail-inbound
# Webhook URL for OIDC token audience verification (your prod URL + path)
# Leave unset in local dev — OIDC verification is skipped if not set
PUBSUB_AUDIENCE=https://<your-prod-url>/api/webhooks/gmail
# Quien pide el token, no solo quien lo firma. La audiencia de un push es la URL
# del endpoint: no es secreta y la elige quien crea la suscripcion, asi que
# cualquiera puede apuntar una suscripcion propia aca. Esta variable es la cuenta
# de servicio de NUESTRA suscripcion; el webhook compara el `email` del token
# contra ella. Obligatoria siempre que PUBSUB_AUDIENCE este puesta: si falta, el
# webhook rechaza (no degrada a aceptar sin mirar) y la casilla solo se lee por
# el cron diario. Sale de:
#   gcloud pubsub subscriptions describe <sub> #     --format='value(pushConfig.oidcToken.serviceAccountEmail)'
PUBSUB_SERVICE_ACCOUNT=<sub-service-account>@<your-project-id>.iam.gserviceaccount.com

# ─── Core system sync ─────────────────────────────────────────────────────────
# El envío real se configura por aseguradora en /configuracion (URL, secreto
# de firma y el interruptor, tabla core_sync_settings de la 0036), no acá. Sin
# eso, sync-to-core contesta 501, no escribe nada y el caso queda en
# listo_para_core hasta que una persona lo marca «Entregado por fuera» o lo
# cierra desde el detalle. Contrato del receptor: docs/entrega-al-core/.
# "mock" es sólo para tests y la demo: pisa la configuración e inventa un
# core_external_id. Cualquier otro valor se ignora.
CORE_SYNC_MODE=

# ─── Email template base URL ──────────────────────────────────────────────────
# Base URL included in outbound email links (e.g. "Click here to confirm")
# Must match the deployed Vercel URL in production
EMAIL_REPLY_BASE_URL=http://localhost:3000

# ─── WhatsApp Business Cloud API (official Meta — ban-safe) ────────────────────
# Production path for receiving claims via WhatsApp. Set up a Meta Business app
# with the WhatsApp product, then register the callback URL:
#   https://<your-prod-url>/api/webhooks/whatsapp
# Do NOT use the unofficial whatsmeow / WhatsApp-Web route — it risks account bans.
#
# Token echoed during Meta's GET verification handshake (you choose this value):
WHATSAPP_VERIFY_TOKEN=<random-token-you-choose>
# Meta App Secret — validates the X-Hub-Signature-256 on every inbound POST:
WHATSAPP_APP_SECRET=<meta-app-secret>
# Cloud API credentials for sending outbound acknowledgements (System User token):
WHATSAPP_ACCESS_TOKEN=<meta-cloud-api-access-token>
WHATSAPP_PHONE_NUMBER_ID=<meta-phone-number-id>
# Graph API version (optional; defaults to v22.0):
WHATSAPP_API_VERSION=v22.0
# Tenant that inbound WhatsApp messages are filed under:
WHATSAPP_TENANT_ID=<tenant-uuid>
# Optional Bearer secret for the normalized (non-Meta) webhook path / simulation:
WHATSAPP_WEBHOOK_SECRET=<random-32-byte-hex>
# WhatsApp Business Account id — lets the code check the approval status of the
# `reabrir_denuncia` template, to reopen a claim after the 24h window. Without it,
# behaviour stays as if no template were approved:
WHATSAPP_BUSINESS_ACCOUNT_ID=<waba-id>

# Who may self-register at /registro or via Google sign-in (full addresses and/or
# @domain entries, comma-separated). ADMIN_EMAILS is implicitly allowed.
# CLOSED when unset: an unconfigured deploy must not hand out access to real claims.
#
# Se mira en DOS momentos y las dos veces con esta misma lista:
#   · `user.create.before` niega la creación de la cuenta. Es el único punto por
#     el que pasan los dos caminos públicos —el formulario de /registro y la
#     primera entrada por Google—, así que nadie ocupa una dirección ajena.
#   · `provisionUserProfile` niega la fila de perfil. Sin perfil no se resuelve
#     inquilino, así que una cuenta que llegara a existir igual no ve nada.
#
# Un admin da de alta a quien quiera desde /admin/users sin tocar esta lista.
#
# Ojo con el formato: `@empresa.com` es el dominio ENTERO y `ana@empresa.com` es
# una dirección sola. No es un detalle cosmético — si el equipo usa casillas de
# Gmail, poner `@gmail.com` acá abre el registro al planeta. En ese caso van las
# direcciones una por una.
SIGNUP_ALLOWED_EMAILS=

# Admins reales, mismo formato que SIGNUP_ALLOWED_EMAILS; siempre pueden registrarse.
# ADMIN_EMAILS=

# ─── La base de ENSAYO, y por qué es otra ─────────────────────────────────────
# Los tests de integración y los e2e escriben: crean casos, sesiones, filas del
# límite de tráfico. Corren contra esta base y nunca contra producción —
# `pnpm sembrar` se planta solo si le pasan la cadena de producción.
#
# En CI son secretos con nombre PROPIO (`E2E_DATABASE_URL`,
# `E2E_DATABASE_URL_APP`) y no `DATABASE_URL`. Eso no es cosmético: con la
# misma variable, apuntar los e2e a producción es un descuido de un segundo que
# después no se ve en ningún lado. Con un nombre distinto hay que ir a crear un
# secreto con ese nombre, que ya es una decisión.
STAGING_DATABASE_URL=
# El mismo ensayo, con el rol restringido (el que NO saltea RLS):
STAGING_DATABASE_URL_APP=
# Adónde sembrar si no es la base de ensayo de arriba (default STAGING_DATABASE_URL).
# SEED_DATABASE_URL=
# Clave de API de Neon: crea y borra ramas del proyecto entero. Sólo para rotar-clave-neon.mts y rehearse-tenancy.mts.
# NEON_API_KEY=

# ─── Las cuentas de prueba que siembra `pnpm sembrar` ─────────────────────────
# Cuatro, y no una, porque el login limita a cinco intentos cada diez segundos
# por IP y correo. Compartiendo cuenta, los tests se comen su propio cupo y
# fallan con «Demasiados intentos» — que en el reporte se lee como un login
# roto. Una por camino y el cupo deja de ser compartido.
#
# ENTRECOMILLÁ LOS VALORES. Una contraseña con `#` adentro, sin comillas,
# dotenv la corta ahí porque toma el resto como comentario: el sembrado guarda
# una clave truncada, el navegador manda la entera, y el login responde
# «Credenciales inválidas» sobre una cuenta recién creada.
#
# La de admin no tiene valor por omisión a propósito: sería la contraseña de
# una cuenta administradora escrita en un repositorio público.
INTEGRATION_TEST_PASSWORD="<24-chars>"    # la analista de los tests de integración
INTEGRATION_ADMIN_PASSWORD="<24-chars>"   # la cuenta admin
INTEGRATION_LOGIN_PASSWORD="<24-chars>"   # los cuatro tests que prueban el login
INTEGRATION_E2E_PASSWORD="<24-chars>"     # la cuenta de los e2e

# El correo de cada cuenta de arriba. Cada uno tiene un valor por omisión en el
# código (@seguros-del-sur.com.ar); poné el propio sólo si sembraste otro.
# INTEGRATION_TEST_EMAIL=
# INTEGRATION_ADMIN_EMAIL=
# INTEGRATION_LOGIN_EMAIL=
INTEGRATION_E2E_EMAIL=

# Cómo correr los e2e en local: docs/TESTING.md, sección 8.

# ─── A quién le avisa una derivación a especialista ───────────────────────────
# Opcional, y hoy NO está puesta en producción a propósito.
#
# Si tiene direcciones, gana sobre los roles: se le avisa a esa lista y a nadie
# más. Sin ella, el aviso va a quien tenga rol `specialist`, que es lo que se
# ve en la pantalla de usuarios y no en el despliegue.
#
# Existe como escotilla para el caso en que no haya ningún especialista todavía.
# Dejarla puesta teniéndolos hace que sumar uno nuevo no cambie nada hasta que
# alguien se acuerde de editar esta variable.
SPECIALIST_ALERT_EMAILS=

# ─── Retención y purga de adjuntos (B19) ──────────────────────────────────────
# Las dos nacen APAGADAS. Las corre el barrido `reap-stuck`, sólo en la ventana de
# las 04 UTC. Valores: `apagado` (por omisión, y también lo que no se entiende),
# `simular` (cuenta y deja una línea en el log, no borra) y `borrar`.
#
# Retención: borra los casos cerrados (cerrado, pagado, rechazado) hace más de
# RETENCION_ANIOS años. No toca clientes, pólizas, la auditoría ni los casos no
# relevantes. Un RETENCION_ANIOS fuera de 1..30 la apaga en vez de achicar el plazo.
# RETENCION_MODO=apagado
# RETENCION_ANIOS=5
#
# Purga: borra de R2 los adjuntos de los casos que ya no existen, pasada la gracia
# (7 a 365 días). Para cancelar una purga puntual, `purgar_despues = NULL` en
# `adjuntos_por_purgar`. No prendas ninguna de las dos sin leer docs/SEGURIDAD.md.
# PURGA_ADJUNTOS_MODO=apagado
# PURGA_GRACIA_DIAS=30

# ─── Scripts que le hablan a producción por HTTP ──────────────────────────────
# Alternativa a `--url` para pnpm smoke, pnpm pentest, pnpm load-test y demás
# (default https://claimmix.vercel.app).
# SMOKE_URL=
# Alternativa a `--tolera` en pnpm smoke: chequeos de salud que hoy no están
# configurados y no deben tumbar el smoke test, separados por coma.
# SMOKE_TOLERA=
# Lo mismo que SMOKE_URL, pero sólo lo lee scripts/mirar-salud.mjs.
# URL=
