# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.local
.env.*.local
# .env.example IS committed (no secrets, only placeholders)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
/playwright-report/
/test-results/

# pnpm
.pnpm-store/

.vercel

# Local example/test emails with real PII — never commit
examplemail*.txt
example-email*.txt
.env*

# Supabase local state (project-ref, temp files)
supabase/.temp/
.git-commit-msg.txt

# Local agent tool state
.claude/
