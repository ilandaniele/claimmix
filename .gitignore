# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.local
.env.*.local
# .env.example IS committed (no secrets, only placeholders)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
/playwright-report/
/test-results/

# pnpm
.pnpm-store/

.vercel

# Local example/test emails with real PII — never commit
examplemail*.txt
example-email*.txt
.env*

# Supabase local state (project-ref, temp files)
supabase/.temp/
.git-commit-msg.txt

# Local agent tool state.
#
# `.claude/*` y no `.claude/`: git no puede volver a incluir algo que está
# adentro de un directorio excluido, así que se excluye el CONTENIDO y se
# rescatan las guías, que sí son del proyecto — valen para cualquiera que
# trabaje acá, no sólo para la máquina donde se bajaron.
.claude/*
!.claude/skills/
# Los workflows de orquestación también: describen cómo se trabaja en este repo.
!.claude/workflows/

# Los enlaces que deja `npx skills` apuntan a una ruta ABSOLUTA de la máquina
# donde se instaló (`/c/Users/…`). El archivo de verdad vive en `.agents/skills/`
# y ése sí se versiona; el enlace no le sirve a nadie más.
.claude/skills/web-design-guidelines

# MCP server config — may carry API tokens (e.g. WhatsApp Cloud API). Keep local.
.mcp.json

# GCP service account keys — never commit credentials
*-sa-key.json
*-service-account.json
*.gcp-key.json

# local scratch notes — may contain sensitive context
prompt.txt

# training exports (large data dumps, regenerate with scripts/export-training.mjs)
training-export/

# Fotos reales para el ensayo de reconocimiento de documentos.
#
# El reconocimiento sólo se puede probar con documentos de verdad, y un
# documento de verdad es el documento de alguien: la licencia que usamos tiene
# nombre, domicilio, fecha de nacimiento y firma del titular. Eso no entra a un
# repositorio, ni siquiera a uno privado — una vez adentro queda en el historial
# para siempre y viaja con cada clon.
#
# Viven en la máquina de quien corre el ensayo. Sin ellas la suite corre igual y
# avisa que esa parte no se ejercitó.
tests/fixtures/*.jpg
tests/fixtures/*.jpeg
tests/fixtures/*.png
tests/fixtures/*.pdf
!tests/fixtures/placeholder.jpg
check.log

# El documento de arquitectura armado para descargar. Se genera a partir de
# docs/ARQUITECTURA*.md, así que versionarlo es guardar la misma cosa dos veces
# —y la copia envejece sin avisar. El archivo se queda en disco; el repo no lo
# sigue.
Arquitectura*ClaimMix.html
Arquitectura*ClaimMix.md
/.swc

# Datos de los flujos durables en local: estado de cada corrida, se regenera.
.workflow-data/
.workflow-vitest/

# Rutas que el SDK de flujos genera en cada build.
src/app/.well-known/workflow/
tests/e2e/.sesiones/
.e2e-env.sh
.dev.log
