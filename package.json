{
  "name": "claimmix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit --noUnusedLocals",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --reporter=verbose",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --reporter=verbose --testTimeout=25000 --hookTimeout=25000 tests/integration",
    "rehearse": "tsx --tsconfig tsconfig.rehearsal.json scripts/rehearse-conversations.mts",
    "smoke": "tsx --tsconfig tsconfig.rehearsal.json scripts/smoke-production.mts",
    "prove": "tsx --tsconfig tsconfig.rehearsal.json scripts/prove-delivery.mts",
    "switch-gcp": "tsx --tsconfig tsconfig.rehearsal.json scripts/switch-gcp-project.mts",
    "mailbox": "tsx --tsconfig tsconfig.rehearsal.json scripts/switch-mailbox.mts",
    "verify": "tsc --noEmit --noUnusedLocals && eslint src --max-warnings=0 && vitest run && pnpm flujos && bash scripts/check-personal-data.sh && node scripts/check-architecture.mjs",
    "check": "tsx --tsconfig tsconfig.rehearsal.json scripts/check-everything.mts",
    "load": "tsx --tsconfig tsconfig.rehearsal.json scripts/load-test.mts",
    "carga:preparar": "node -e \"require('fs').mkdirSync('resultados',{recursive:true})\"",
    "carga:smoke": "pnpm carga:preparar && k6 run tests/load/scenarios/smoke.js",
    "carga:load": "pnpm carga:preparar && k6 run tests/load/scenarios/load.js",
    "carga:stress": "pnpm carga:preparar && k6 run tests/load/scenarios/stress.js",
    "carga:spike": "pnpm carga:preparar && k6 run tests/load/scenarios/spike.js",
    "carga:soak": "pnpm carga:preparar && k6 run tests/load/scenarios/soak.js",
    "carga:peak": "pnpm carga:preparar && k6 run tests/load/scenarios/peak.js",
    "carga:publico": "pnpm carga:preparar && k6 run tests/load/scenarios/publico.js",
    "pentest": "tsx --tsconfig tsconfig.rehearsal.json scripts/pen-test.mts",
    "onboard": "tsx --tsconfig tsconfig.rehearsal.json scripts/rehearse-onboarding.mts",
    "knock": "tsx --tsconfig tsconfig.rehearsal.json scripts/knock-on-the-door.mts",
    "tenancy": "tsx --tsconfig tsconfig.rehearsal.json scripts/prove-tenancy.mts",
    "ensayo-tenencia": "tsx --tsconfig tsconfig.rehearsal.json scripts/rehearse-tenancy.mts",
    "esquemas": "tsx --tsconfig tsconfig.rehearsal.json scripts/compare-schemas.mts",
    "rol-app": "tsx --tsconfig tsconfig.rehearsal.json scripts/create-app-role.mts",
    "capa-datos": "tsx --tsconfig tsconfig.rehearsal.json scripts/prove-data-layer.mts",
    "filtros": "node scripts/count-tenant-filters.mjs",
    "puente": "node scripts/add-scope-bridge.mjs",
    "arquitectura": "node scripts/check-architecture.mjs",
    "permisos": "tsx --tsconfig tsconfig.rehearsal.json scripts/prove-grants.mts",
    "bases:empaquetar": "node scripts/empaquetar-bases.mjs",
    "bases:probar": "tsx --tsconfig tsconfig.rehearsal.json scripts/probar-bases.mts",
    "flujos": "vitest run --config vitest.workflows.config.ts",
    "listo": "pnpm permisos && pnpm capa-datos && pnpm tenancy && pnpm arquitectura",
    "cobertura": "vitest run --coverage",
    "busqueda": "tsx --tsconfig tsconfig.rehearsal.json scripts/medir-busqueda.mts",
    "explicar-busqueda": "tsx --tsconfig tsconfig.rehearsal.json scripts/explicar-busqueda.mts",
    "sembrar": "tsx --tsconfig tsconfig.rehearsal.json scripts/sembrar-para-integracion.mts",
    "sembrar-adjunto": "tsx --tsconfig tsconfig.rehearsal.json scripts/sembrar-adjunto-grande.mts",
    "padron": "tsx --tsconfig tsconfig.rehearsal.json scripts/sembrar-padron.mts",
    "indices": "tsx --tsconfig tsconfig.rehearsal.json scripts/auditar-indices.mts",
    "rls-indices": "tsx --tsconfig tsconfig.rehearsal.json scripts/medir-rls-indices.mts",
    "peso": "node scripts/medir-peso.mjs",
    "peso:ver": "next experimental-analyze",
    "comparar-ensayos": "node scripts/comparar-ensayos.mjs",
    "achicar-payloads": "tsx --tsconfig tsconfig.rehearsal.json scripts/achicar-payloads.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@googleapis/gmail": "^22.0.2",
    "@neondatabase/serverless": "1.1.0",
    "@sentry/nextjs": "^11.7.0",
    "@vercel/oidc": "3.8.5",
    "better-auth": "^1.7.8",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workflow": "^4.8.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "@workflow/vitest": "^4.0.29",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": "2.8.0",
      "esbuild": ">=0.28.1 <0.29",
      "browserslist": ">=4.28.7 <5",
      "devalue": ">=5.9.3 <6",
      "postcss": ">=8.5.18 <9",
      "fast-uri": ">=4.1.3 <5",
      "js-yaml": ">=5.4.1 <6",
      "sharp": ">=0.35.5 <0.36",
      "brace-expansion@1": ">=1.1.21 <2",
      "brace-expansion@2": ">=2.1.2 <3",
      "brace-expansion@5": ">=5.0.11 <6",
      "minimatch@9>brace-expansion": ">=5.0.11 <6",
      "nanoid": ">=3.3.18 <7",
      "qs": ">=6.16.0 <7",
      "undici": ">=7.29.1 <8",
      "proxy-addr": ">=2.0.8 <3",
      "source-map-js": ">=1.2.2 <2",
      "http-cache-semantics": ">=4.3.0 <5",
      "@next/eslint-plugin-next>fast-glob": "npm:tinyglobby@^0.2.17"
    },
    "patchedDependencies": {
      "builtin-modules@5.0.0": "patches/builtin-modules@5.0.0.patch"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "cbor-extract",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
