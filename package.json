{
  "name": "claimmix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=5",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --reporter=verbose",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "cleanup:cases": "tsx scripts/cleanup-cases.ts",
    "rehearse": "tsx --tsconfig tsconfig.rehearsal.json scripts/rehearse-conversations.mts",
    "smoke": "tsx --tsconfig tsconfig.rehearsal.json scripts/smoke-production.mts",
    "prove": "tsx --tsconfig tsconfig.rehearsal.json scripts/prove-delivery.mts",
    "switch-gcp": "tsx --tsconfig tsconfig.rehearsal.json scripts/switch-gcp-project.mts",
    "mailbox": "tsx --tsconfig tsconfig.rehearsal.json scripts/switch-mailbox.mts",
    "verify": "tsc --noEmit && eslint src --max-warnings=0 && vitest run && bash scripts/check-personal-data.sh",
    "check": "tsx --tsconfig tsconfig.rehearsal.json scripts/check-everything.mts",
    "load": "tsx --tsconfig tsconfig.rehearsal.json scripts/load-test.mts",
    "pentest": "tsx --tsconfig tsconfig.rehearsal.json scripts/pen-test.mts",
    "onboard": "tsx --tsconfig tsconfig.rehearsal.json scripts/rehearse-onboarding.mts",
    "knock": "tsx --tsconfig tsconfig.rehearsal.json scripts/knock-on-the-door.mts",
    "tenancy": "tsx --tsconfig tsconfig.rehearsal.json scripts/prove-tenancy.mts",
    "ensayo-tenencia": "tsx --tsconfig tsconfig.rehearsal.json scripts/rehearse-tenancy.mts",
    "esquemas": "tsx --tsconfig tsconfig.rehearsal.json scripts/compare-schemas.mts",
    "rol-app": "tsx --tsconfig tsconfig.rehearsal.json scripts/create-app-role.mts",
    "capa-datos": "tsx --tsconfig tsconfig.rehearsal.json scripts/prove-data-layer.mts",
    "filtros": "node scripts/count-tenant-filters.mjs",
    "filtros:analizar": "node scripts/analyze-tenant-filters.mjs",
    "filtros:migrar": "node scripts/migrate-tenant-filters.mjs",
    "puente": "node scripts/add-scope-bridge.mjs",
    "ctx": "node scripts/declare-tenant-ctx.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.59.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.1",
    "openai": "^4.98.0",
    "pino": "^9.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^26.1.0",
    "pg": "^8.21.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": "2.8.0",
      "esbuild": ">=0.28.1",
      "form-data": "4.0.6",
      "postcss": ">=8.5.18",
      "fast-uri": ">=4.1.2",
      "js-yaml": ">=4.3.0",
      "sharp": ">=0.35.0",
      "brace-expansion@1": ">=1.1.16",
      "brace-expansion@2": ">=2.1.2",
      "brace-expansion@5": ">=5.0.9",
      "minimatch@9>brace-expansion": ">=5.0.9",
      "nanoid": ">=3.3.18"
    }
  }
}
