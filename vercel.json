{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/gmail-poll",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reap-stuck",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "src/app/api/webhooks/gmail/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/gmail-poll/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/reap-stuck/route.ts": { "maxDuration": 60 },
    "src/app/api/worker/extract/route.ts": { "maxDuration": 60 }
  }
}
